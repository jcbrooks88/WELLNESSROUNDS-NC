{
    "name": "mern-monorepo",
    "private": true,
    "workspaces": [
      "apps/*",
      "packages/*"
    ],
    "scripts": {
      "dev": "concurrently \"npm run dev --workspace=apps/client\" \"npm run dev --workspace=apps/server\"",
      "build": "npm run build --workspace=apps/client && npm run build --workspace=apps/server",
      "lint": "eslint .",
      "type-check": "tsc --noEmit"
    },
    "devDependencies": {
      "concurrently": "^8.2.2",
      "eslint": "^9.21.0",
      "typescript": "^5.8.3",
      "ts-node": "^10.9.2",
      "nodemon": "^3.1.9"
    }
  }
  
{
    "name": "server",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
      "dev": "nodemon --watch src --ext ts --exec ts-node-esm src/server.ts",
      "build": "tsc",
      "start": "node dist/server.js",
      "prestart": "npm run build",
      "seed": "ts-node src/seed/seedDatabase.ts",
      "type-check": "tsc --noEmit",
      "clean": "rm -rf dist"
    },
    "dependencies": {
      "apollo-server-express": "^3.13.0",
      "bcrypt": "^5.1.1",
      "dotenv": "^16.4.7",
      "express": "^4.21.2",
      "express-graphql": "^0.12.0",
      "graphql": "^15.8.0",
      "jsonwebtoken": "^9.0.2",
      "lodash.merge": "^4.6.2",
      "mongodb": "^6.15.0",
      "mongoose": "^8.13.1"
    }
  }
  
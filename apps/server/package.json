{
    "name": "server",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --exec \"node --loader ts-node/esm\" src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "prestart": "npm run build",
        "seed": "ts-node src/seed/seedDatabase.ts",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "mongoose": "...",
        "apollo-server-express": "workspace:*",
        "express": "workspace:*",
        "graphql": "workspace:*"
},
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/lodash.merge": "^4.6.9",
        "@types/node": "^22.14.0",
        "nodemon": "^3.1.9",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
  }
}
